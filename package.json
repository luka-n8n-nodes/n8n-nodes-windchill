{
  "name": "@luka-cat-mimi/n8n-nodes-windchill",
  "version": "0.1.1",
  "description": "PTC Windchill PLM REST/OData API integration for n8n",
  "keywords": [
    "n8n",
    "n8n-node",
    "n8n-community-node-package",
    "windchill",
    "ptc",
    "plm",
    "odata"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/luka-n8n-nodes/n8n-nodes-windchill#readme",
  "author": {
    "name": "luka-cat",
    "email": "luka.cat.mimi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka-n8n-nodes/n8n-nodes-windchill.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier credentials nodes --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test test/**/*.mjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/WindchillBasicApi.credentials.js",
      "dist/credentials/WindchillTokenApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Windchill/Windchill.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.4",
    "@types/node": "^20.19.43",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
